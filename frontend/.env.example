# URL backend Laravel (API publik).
# Lokal (php artisan serve): http://127.0.0.1:8000
# Produksi: isi dengan URL backend Laravel yang sudah live.
# Bila dikosongkan / tidak diisi, kode memakai default
# http://127.0.0.1:8000 dan bila backend tidak terjangkau, situs
# otomatis memakai data statis dari src/data.js (fallback).
# Variabel ini JUGA dipakai tombol "Login Admin" di navbar:
# tombol itu mengarah ke {VITE_API_URL}/login, jadi di Vercel
# frontend wajib diisi dengan URL backend Vercel, lalu redeploy,
# supaya tombol tidak mengarah ke localhost.
VITE_API_URL=http://127.0.0.1:8000
